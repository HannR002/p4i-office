# ==============================================================================
# P4I Office v1.0 — Konfigurasi Lingkungan (Environment Variables)
# PERINGATAN: File ini adalah template. Jangan pernah commit kredensial asli!
# ==============================================================================

# Port & URL Aplikasi
PORT=3000
NEXT_PUBLIC_APP_NAME="P4I Office"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Basis Data PostgreSQL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/p4i_office_test"
DATABASE_SSL="false"

# Keamanan Sesi & Otentikasi
# Wajib string acak minimal 32 karakter pada lingkungan produksi
SESSION_SECRET="change-this-to-a-secure-random-32-character-secret-in-production"
SESSION_MAX_AGE_SECONDS=28800 # 8 jam

# Rate Limiting Login
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300 # 5 menit

# ==============================================================================
# SPRINT 1A SAFETY GUARDS — JANGAN AKTIFKAN DI PRODUKSI TANPA MANDAT SAH
# ==============================================================================
# Penomoran surat resmi harus selalu 'false' pada Sprint 1A
FEATURE_NUMBERING_ACTIVE="false"

# Penandatanganan dokumen resmi harus selalu 'false' pada Sprint 1A
FEATURE_SIGNING_ACTIVE="false"

# Seed test data flag: HANYA boleh bernilai true untuk database pengujian lokal
ALLOW_TEST_SEED="true"
